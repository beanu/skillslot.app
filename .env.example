# Server-only URL for the existing SkillSlot Creem proxy.
SKILLSLOT_CREEM_PROXY_BASE=http://127.0.0.1:3000/api/v1/creem

# Optional: set only after this URL works for logged-out visitors and starts a
# macOS download (or opens a public macOS release page). Download CTAs stay hidden
# when this value is empty.
NEXT_PUBLIC_SKILLSLOT_DOWNLOAD_URL=
